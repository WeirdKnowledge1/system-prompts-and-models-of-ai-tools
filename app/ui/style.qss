}
QWidget[jurisdiction="postal"] QLineEdit,
QWidget[jurisdiction="postal"] QTextEdit {
    background-color: #FFFFF0; // Light ivory for postal gold background
    color: black;
}
*/

/* Ensure input fields have good contrast if jurisdictional colors are dark */
QLineEdit, QTextEdit, QComboBox, QSpinBox, QListWidget {
    /* These are already defined above with white background, good for most cases */
}
QLabel { /* Ensure labels are readable on colored backgrounds */
    /* This is tricky globally; best handled by MainWindow._on_tab_changed logic */
    /* background-color: transparent; */ /* To let tab background show through */
}

